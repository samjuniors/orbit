{
  "name": "orbit-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "ORBIT Desktop (v0.7.0) - Unattended AI coding agent harness for Claude Code, Codex, Antigravity, OpenCode, Grok Build.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win nsis",
    "pack:win": "electron-builder --win dir",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js && node --check src/engine/plan.js && node --check src/engine/policy.js && node --check src/engine/adapters.js && node --check src/engine/engine.js"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.samjuniors.orbit.desktop",
    "productName": "ORBIT Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Orbit-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORBIT Desktop"
    }
  }
}